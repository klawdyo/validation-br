{
  "name": "validation-br",
  "description": "Brazilian personal documents validation - cpf, cnpj, titulo, pis/pasep, cnh, renavam, processos judiciais, protocolo federal, código de rastreamento dos correios",
  "version": "2.0.0",
  "author": "Cláudio Medeiros <klawdyo@gmail.com>",
  "license": "MIT",
  "sideEffects": false,
  "type": "commonjs",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/cjs/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/cjs/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/cjs/index.js"
    },
    "./*": {
      "types": "./dist/cjs/*.d.ts",
      "import": "./dist/esm/*.js",
      "require": "./dist/cjs/*.js",
      "default": "./dist/cjs/*.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "base": ["dist/cjs/base.d.ts"],
      "boleto": ["dist/cjs/boleto.d.ts"],
      "caepf": ["dist/cjs/caepf.d.ts"],
      "carplate": ["dist/cjs/carplate.d.ts"],
      "cbi_sinter": ["dist/cjs/cbi_sinter.d.ts"],
      "cep": ["dist/cjs/cep.d.ts"],
      "certidao": ["dist/cjs/certidao.d.ts"],
      "cnh": ["dist/cjs/cnh.d.ts"],
      "cnpj": ["dist/cjs/cnpj.d.ts"],
      "cpf": ["dist/cjs/cpf.d.ts"],
      "email": ["dist/cjs/email.d.ts"],
      "judicial-process": ["dist/cjs/judicial-process.d.ts"],
      "nup17": ["dist/cjs/nup17.d.ts"],
      "phone": ["dist/cjs/phone.d.ts"],
      "pis-pasep": ["dist/cjs/pis-pasep.d.ts"],
      "pix-copy-paste": ["dist/cjs/pix-copy-paste.d.ts"],
      "pix-key": ["dist/cjs/pix-key.d.ts"],
      "postal-track-code": ["dist/cjs/postal-track-code.d.ts"],
      "renavam": ["dist/cjs/renavam.d.ts"],
      "tituloEleitor": ["dist/cjs/tituloEleitor.d.ts"],
      "uf": ["dist/cjs/uf.d.ts"],
      "uuid": ["dist/cjs/uuid.d.ts"]
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:dual-build": "npm run build && node test/dual-build/require.test.cjs && node test/dual-build/import.test.mjs",
    "format": "prettier --write \"./**/*.{js,ts,json}\"",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build": "rm -rf dist && npm run build:cjs && npm run build:esm && node scripts/postbuild.mjs",
    "prepublishOnly": "npm run build"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "prettier --write",
      "eslint --cache --fix"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.2",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "ts-node": "^9.0.0",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11"
  },
  "repository": {
    "url": "https://github.com/klawdyo/validation-br"
  },
  "bugs": {
    "url": "https://github.com/klawdyo/validation-br/issues"
  },
  "homepage": "https://github.com/klawdyo/validation-br#readme",
  "keywords": [
    "validation-br",
    "validation",
    "personal documents",
    "document",
    "brazil",
    "brasil",
    "brazilian",
    "brasileiro",
    "cpf",
    "cnpj",
    "pis",
    "pasep",
    "cnh",
    "titulo eleitor",
    "eleitoral",
    "titulo",
    "renavam",
    "processos",
    "judiciais",
    "judicial",
    "justiça",
    "protocolo",
    "federal",
    "fake",
    "falso",
    "mock",
    "faker",
    "mockup",
    "mask",
    "mascara",
    "fake cpf",
    "fake cnpj",
    "fake cnh",
    "fake pis",
    "fake pasep",
    "fake cadunico",
    "fake renavam",
    "fake titulo",
    "fake titulo eleitor",
    "fake titulo eleitoral",
    "fake número processo",
    "processo justiça",
    "processo judicial",
    "valida",
    "validar",
    "validação",
    "valide",
    "validate",
    "format",
    "formatar",
    "formatador",
    "formatter",
    "nest",
